# Neon PostgreSQL (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Optional: Neon direct (non-pooler) URL for migrations when DATABASE_URL uses -pooler
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Faz 2 — admin auth
ADMIN_EMAIL="admin@pixora.com"
ADMIN_PASSWORD="change-me-min-8-chars"
ADMIN_SESSION_SECRET="generate-a-long-random-string-at-least-16-chars"

# Optional EDITOR role (pnpm db:sync-editor — only created when EDITOR_PASSWORD is set)
EDITOR_EMAIL="editor@pixora.com"
EDITOR_PASSWORD=

# Public site origin (no trailing slash) — used when seo.canonicalBaseUrl is empty
NEXT_PUBLIC_SITE_URL="https://getpixoria.com"

# Optional: Vercel Blob (when set, media uploads go to Blob instead of public/uploads)
BLOB_READ_WRITE_TOKEN=
